            "creationInfo": "_:creationinfo",
            "name": "RetinaScan AI",
            "summary": "AI model for automated diabetic retinopathy grading from fundus photographs.",
            "description": "A convolutional neural network that classifies diabetic retinopathy severity (no DR, mild, moderate, severe, proliferative) from retinal fundus images. Intended for use as a decision-support tool under ophthalmologist supervision.",
            "software_packageVersion": "2.1.0",
            "software_primaryPurpose": "model",
            "software_downloadLocation": "https://example.com/retinascan-ai",
            "software_copyrightText": "Copyright 2024 MedTech Imaging Solutions",
            "ai_typeOfModel": [
                "convolutional neural network",
                "supervised"
            ],
            "ai_domain": [
                "medical imaging",
                "ophthalmology",
                "diabetic retinopathy screening"
            ],
            "ai_limitation": "Performance may degrade on images captured with equipment not represented in training data. Not validated for pediatric patients or patients with co-existing ocular conditions other than diabetic retinopathy. Requires image quality score above threshold before classification.",
            "ai_safetyRiskAssessment": "high",
            "ai_standardCompliance": [
                "IEC 62304:2006+AMD1:2015",
                "ISO 14971:2019",
                "EU MDR 2017/745 Class IIb"
            ],
            "ai_informationAboutApplication": "Deployed as a triage tool within ophthalmology screening workflows. A trained clinician reviews all AI-generated classifications before clinical decisions are made. The system flags images below quality threshold for re-capture.",
            "ai_informationAboutTraining": "Trained on a curated dataset of 180,000 fundus photographs with expert grading labels following the International Clinical Diabetic Retinopathy Disease Severity Scale. Class imbalance addressed via weighted sampling. Transfer learning from ImageNet-pretrained backbone.",
            "ai_modelDataPreprocessing": [
                "CLAHE contrast enhancement",
                "Center crop to optic disc region",
                "Resize to 512x512 pixels",
                "Normalization to ImageNet mean and standard deviation"
            ],
            "ai_modelExplainability": [
                "Grad-CAM saliency maps generated at inference time to highlight retinal regions influencing the classification",
                "Uncertainty estimation via MC Dropout (20 forward passes)"
            ],
            "ai_metric": [
                {
                    "type": "DictionaryEntry",
                    "key": "AUC-ROC (referable DR)",
                    "value": "0.97"
                },
                {
                    "type": "DictionaryEntry",
                    "key": "sensitivity",
                    "value": "0.95"
                },
                {
                    "type": "DictionaryEntry",
                    "key": "specificity",
                    "value": "0.93"
                }
            ],
            "ai_useSensitivePersonalInformation": "yes"
